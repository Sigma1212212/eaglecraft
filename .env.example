# Copy to .env — start.sh loads it automatically.
# cp .env.example .env

# --- website ---------------------------------------------------------------
PORT=8080                 # NOTE: something is already listening on 8080 on this
                          # PC. Use 8081 if --check-ports complains.

# --- RAM -------------------------------------------------------------------
# SMP_RAM_MB is the budget for the WHOLE network. The proxy takes
# SMP_PROXY_RAM_MB and Paper gets everything that is left, so these two heaps
# can never over-commit the host.
#   8 GB machine  -> 4096
#   16 GB machine -> 8192
#   32 GB machine -> 12288  (past ~12 GB you get diminishing returns and
#                            longer GC pauses, not a smoother server)
SMP_RAM_MB=4096
SMP_PROXY_RAM_MB=512

# --- ports -----------------------------------------------------------------
SMP_PORT=25577            # proxy: this is what players type in Direct Connect
                          # Paper is hard-bound to 127.0.0.1:25565 and is never
                          # reachable from outside this machine.

# --- behaviour -------------------------------------------------------------
AUTOSTART_SMP=1           # boot the SMP with the website
SMP_CONSOLE_LINES=800     # console scrollback kept in RAM, per process
SMP_READY_TIMEOUT=180     # seconds to wait for "Done!" before opening the proxy
QUOTA_MB=150              # per-account world storage

# --- java ------------------------------------------------------------------
# Only needed if you do NOT want the bundled JRE from setup.sh.
# Must be Java 17+; Paper 1.20.4 will not start on Java 8 or 11.
#JAVA21_HOME=/usr/lib/jvm/temurin-21-jre
